# Скопируйте в .env и при необходимости поменяйте значения.

# БД: в dev по умолчанию SQLite-файл. Для прода — PostgreSQL, например:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dariyut
DATABASE_URL=sqlite:///./dariyut.db

# Секрет для подписи JWT и сессии админки. В проде задайте случайную строку.
SECRET_KEY=change-me-in-production-please-use-a-long-random-string

# Время жизни access-токена (минуты).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Параметры запуска сервера через `python -m app.main`.
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Разрешённые источники для CORS (адрес фронта), через запятую.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Данные первого админа (используются скриптом scripts/create_admin.py).
FIRST_ADMIN_EMAIL=admin@dari-yut.ru
FIRST_ADMIN_PASSWORD=admin12345
FIRST_ADMIN_NAME=Администратор
