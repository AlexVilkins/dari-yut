# ── Переменные для docker compose (скопируйте в .env и заполните) ─────────────

# Публичный адрес сайта (с https). Используется как NUXT_PUBLIC_API_BASE и CORS.
SITE_URL=https://дари-уют.рф

# PostgreSQL
POSTGRES_USER=dariyut
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СЛУЧАЙНЫЙ_ПАРОЛЬ
POSTGRES_DB=dariyut

# Секрет для JWT и сессий админки. Сгенерируйте: openssl rand -hex 32
SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Кол-во воркеров uvicorn (≈ числу ядер CPU).
WEB_CONCURRENCY=2

# Первый администратор (создаётся при старте бэкенда).
FIRST_ADMIN_EMAIL=admin@dari-yut.ru
FIRST_ADMIN_PASSWORD=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ
FIRST_ADMIN_NAME=Администратор

# Email для уведомлений Let's Encrypt (используется при выпуске сертификата).
CERTBOT_EMAIL=alexeymozhzhukhin@gmail.com
